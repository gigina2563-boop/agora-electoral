# Copiá este archivo a `.streamlit/secrets.toml` para desarrollo local.
# En Streamlit Community Cloud, cargá las mismas claves en "Secrets".
# NUNCA subas `.streamlit/secrets.toml` al repositorio.

# Acceso de la administradora (obligatorio para cargar o homologar datos).
# Generá el hash con: python -m agora.auth
# Nunca guardes la contraseña en texto plano ni subas este archivo con valores
# reales al repositorio.
ADMIN_PASSWORD_HASH = "pbkdf2_sha256$600000$SAL_FICTICIA$HASH_FICTICIO"

# Proveedor principal de producción.
GROQ_API_KEY = "gsk_reemplazar"
GROQ_MODEL = "openai/gpt-oss-120b"

# Respaldo opcional en la nube.
# GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-2.5-flash"

# Entorno: produccion | local | dev | test
# En `local` se habilita Ollama. En producción queda deshabilitado.
AGORA_ENTORNO = "produccion"

# Ollama solo para desarrollo local.
# OLLAMA_ENABLED = "true"
# OLLAMA_HOST = "http://localhost:11434"
# OLLAMA_MODEL = "gemma3:1b"

# Ruta persistente opcional para SQLite (volumen de Render/Railway).
# AGORA_DB_PATH = "/var/data/observatorio.db"

# Desactivar la carga de la base semilla (útil para pruebas E2E).
# AGORA_SEED = "0"
